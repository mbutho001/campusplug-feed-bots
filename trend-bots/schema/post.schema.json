{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campus Plug trend-desk post",
  "type": "object",
  "required": ["post_id", "run_date", "slot", "cluster_key", "fingerprint", "headline", "caption", "body",
               "category", "tags", "format", "source_url", "source_published_at", "discovered_at",
               "verification_status", "verification_notes", "confidence", "trend_score", "score_components",
               "geo", "audience", "poll", "image_instructions", "attribution", "risk", "approval_status",
               "scheduled_for", "publication_status", "metrics", "expires_at", "formats", "sources"],
  "properties": {
    "post_id": {"type": "string", "pattern": "^tb-[0-9]{8}-[a-z]+-[0-9a-f]{16}$"},
    "run_date": {"type": "string", "format": "date"},
    "slot": {"enum": ["morning", "midday", "afternoon", "evening"]},
    "cluster_key": {"type": "string", "minLength": 8},
    "fingerprint": {"type": "string"},
    "bot": {"type": ["string", "null"]},
    "headline": {"type": "string", "minLength": 10, "maxLength": 90},
    "caption": {"type": "string", "minLength": 10, "maxLength": 140},
    "body": {"type": "string", "minLength": 150, "maxLength": 900},
    "category": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}, "maxItems": 8},
    "format": {"enum": ["summary", "poll", "discussion", "humour", "explainer", "quiz"]},
    "source_url": {"type": "string", "pattern": "^https?://"},
    "source_outlet": {"type": "string"},
    "source_published_at": {"type": ["string", "null"]},
    "discovered_at": {"type": "string"},
    "verification_status": {"enum": ["confirmed", "corroborated", "single_source", "allegation", "disputed", "unverified"]},
    "verification_notes": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "trend_score": {"type": "number", "minimum": 0, "maximum": 1},
    "score_components": {
      "type": "object",
      "required": ["freshness", "momentum", "student_relevance", "sa_relevance", "engagement_potential", "credibility"],
      "additionalProperties": {"type": "number"}
    },
    "trend_evidence": {"type": "array", "items": {"type": "string"}},
    "geo": {"type": "string"},
    "audience": {"type": "string"},
    "poll": {
      "type": ["object", "null"],
      "required": ["question", "options"],
      "properties": {
        "question": {"type": "string", "minLength": 8, "maxLength": 200},
        "options": {"type": "array", "minItems": 2, "maxItems": 4, "uniqueItems": true,
                    "items": {"type": "string", "minLength": 1, "maxLength": 60}}
      }
    },
    "image_instructions": {"type": "string"},
    "attribution": {"type": "string", "minLength": 3},
    "risk": {"enum": ["low", "medium", "high"]},
    "risk_notes": {"type": "string"},
    "approval_status": {"enum": ["auto_approved", "needs_review", "approved", "rejected"]},
    "review_reasons": {"type": "array", "items": {"type": "string"}},
    "scheduled_for": {"type": ["string", "null"]},
    "publication_status": {"enum": ["draft", "scheduled", "published", "failed", "expired", "rejected", "held"]},
    "metrics": {"type": "object"},
    "expires_at": {"type": ["string", "null"]},
    "formats": {"type": "object"},
    "sources": {"type": "array", "minItems": 1}
  }
}
